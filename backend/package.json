{
  "name": "@certiflow/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "bullmq": "5.52.2",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "ioredis": "5.6.1",
    "multer": "1.4.5-lts.2",
    "pdfkit": "0.16.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.18",
    "@types/express": "5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "22.15.3",
    "@types/pdfkit": "^0.13.8",
    "@types/supertest": "6.0.3",
    "prisma": "6.7.0",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
